POSTGRES_DB=asset_management
POSTGRES_USER=asset_management
POSTGRES_PASSWORD=change-me-for-local-only
POSTGRES_PORT=5432

DATABASE_URL=postgresql://asset_management:change-me-for-local-only@localhost:5432/asset_management
NEXT_PUBLIC_APP_ENV=local
APP_PORT=3000

# HR inbound webhook signing secret (HMAC-SHA256)
HR_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Signs the demo login cookie (HMAC-SHA256). Required when NODE_ENV=production
# (next start, Docker); while it is empty those refuse to serve pages.
# npm run dev uses a fixed dev secret when this is empty.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
